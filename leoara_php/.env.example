# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit the real .env file to version control or leave it web-readable.

# --- Database (from cPanel > MySQL Databases) ---
DB_HOST=localhost
DB_NAME=cpuser_leora
DB_USER=cpuser_leorauser
DB_PASS=change_me
DB_PORT=3306

# --- App ---
APP_ENV=production
APP_URL=https://yourdomain.com
APP_KEY=change_me_to_a_random_32_char_string
SESSION_LIFETIME_MINUTES=120
REMEMBER_ME_DAYS=30

# --- Mail (used for verification / password reset emails) ---
# cPanel shared hosting can usually send mail via PHP's built-in mail()
# using the domain's own mail server with no extra config. If deliverability
# is poor, switch MAIL_DRIVER to "smtp" and fill in SMTP_* (e.g. an SMTP
# app password from your cPanel email account, or a transactional provider).
MAIL_DRIVER=php_mail
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="Leora Events"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# --- Google Sign-In ---
# Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# (Application type: Web application). Add your domain under "Authorized
# JavaScript origins" (e.g. https://yourdomain.com). No client secret is
# needed for this flow — the browser gets a signed ID token from Google and
# our backend verifies it server-side against this same client ID.
GOOGLE_CLIENT_ID=

# --- Phone OTP (SMS) ---
# cPanel shared hosting has no built-in SMS capability, so you need an SMS
# gateway. SMS_DRIVER=log writes the OTP to the PHP error log instead of
# sending a real text — useful for testing, but MUST be switched to "http"
# with real credentials before go-live (see includes/SmsSender.php).
# Works with any provider that accepts a simple GET/POST REST call, e.g.
# AfroMessage, GeezSMS, Twilio.
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=LeoraEvents
