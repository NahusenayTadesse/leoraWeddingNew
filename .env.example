# ---------------------------------------------------------------------------
# Leora Events — environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MySQL / MariaDB. Create the database with utf8mb4 (see README → Database).
# Local development: a database of your own, never a shared server.
DATABASE_URL="mysql://dev@localhost:3306/leora_dev"

# Public URL of the site, no trailing slash. Required in production (auth links,
# emails, adapter-node). In development it may be left empty: the dev server's
# own origin is used, on any localhost port.
ORIGIN=""

# better-auth: 32+ random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# --- Payments (Chapa) -------------------------------------------------------
# Secret key from the Chapa dashboard (CHASECK_TEST-… in test mode).
CHAPA_SECRET_KEY=""
# Optional: the webhook secret set in Chapa → Settings → Webhooks. Webhook URL:
#   https://YOUR-DOMAIN/api/payments/chapa/callback
CHAPA_WEBHOOK_SECRET=""

# --- Email (SMTP) -----------------------------------------------------------
# Password resets, email confirmation and notifications. In development, leave
# SMTP_HOST empty and messages are printed to the terminal instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Leora Events <no-reply@leoraevents.et>"

# --- AI assistant (optional) ------------------------------------------------
# Google Gemini key. Without it the chat widget answers with an error.
GEMINI_KEY=""
# Signs the per-device chat limit cookie; defaults to BETTER_AUTH_SECRET.
CHAT_LIMIT_SECRET=""

# --- Files ------------------------------------------------------------------
# Where uploads (vendor images, receipts, contracts) are stored. Back it up.
FILES_DIR=".tempFiles"

# --- Production server (adapter-node) ---------------------------------------
PORT="3000"
# Uploads are up to 10 MB; adapter-node's default body limit is 512K, which
# silently drops receipt photos. Keep this at 12M or more.
BODY_SIZE_LIMIT="12M"
# Staff (admin/support) must use two-step verification. Defaults to on in
# production and off in development; set to "true"/"false" to override.
# REQUIRE_STAFF_2FA="true"
# Background jobs (payment reconcile, plan expiry). Run them in ONE process only:
# set to "false" on any additional app instances.
# RUN_JOBS="true"

# --- Tests ------------------------------------------------------------------
# Database for `npm test`. Its name must end in _test; it is emptied by tests.
# TEST_DATABASE_URL="mysql://dev@localhost:3306/leora_test"
