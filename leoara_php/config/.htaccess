# Defense in depth: deny all direct web requests to this folder, portable
# across Apache 2.2 and 2.4 (only one of the two IfModule blocks applies on
# any given server, so this never fails to parse).
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
